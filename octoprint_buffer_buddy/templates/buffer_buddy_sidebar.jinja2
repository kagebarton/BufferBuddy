Status: <strong data-bind="text: status">Starting...</strong> <span class="muted" data-bind="visible: !enabled()">(monitoring only)</span>
<br />
<div data-bind="visible: advancedOkDetected() && hasStats()">
  <!-- ko if: jobActive -->
  Throughput: <strong><span data-bind="text: linesPerSecond">_</span> lines/s</strong>
  <br />
  In flight: <strong><span data-bind="text: inflight">_</span> lines</strong><!-- ko if: enabled() && limitedByText() --> <span class="muted" data-bind="text: limitedByText"></span><!-- /ko -->
  <br />
  <!-- /ko -->
  <!-- ko if: printing -->
  Planner: <strong><span data-bind="text: plannerQueued">_</span> / <span data-bind="text: plannerBufferSize">_</span> moves</strong>
  <br />
  <!-- /ko -->
  <!-- ko if: plannerQueuedAvg() !== null -->
  Planner average: <strong><span data-bind="text: plannerQueuedAvg">_</span> moves</strong>
  <br />
  <!-- /ko -->
  <!-- ko if: inflightAvg() !== null -->
  In flight average: <strong><span data-bind="text: inflightAvg">_</span> lines</strong>
  <br />
  <!-- /ko -->
  Resends: <strong data-bind="text: resendsDetected">_</strong>
  <br />
</div>

<small class="muted">
  <span data-bind="visible: state() === 'detecting'">
    If this stays on detecting, your firmware probably lacks the ADVANCED_OK output BufferBuddy needs.
    <br />
  </span>
  <span data-bind="visible: advancedOkDetected">
    Command buffer: <span data-bind="text: commandBufferSize"></span> · stats reset each print
    <br />
  </span>
  <a href="#" title="Open BufferBuddy settings" data-bind="click: openSettings">Settings</a>
</small>
